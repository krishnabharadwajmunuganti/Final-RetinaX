# RetinaX Backend Environment Variables
# ======================================

# Database Connection (Supabase PostgreSQL or local SQLite fallback)
# Leave blank to use local SQLite (sqlite:///./retinax.db) for zero-setup offline dev
# Or provide your Supabase PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./retinax.db

# JWT Authentication Secret and Algorithm
JWT_SECRET=retinax-super-secure-jwt-secret-key-sih-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Port and Base URL
PORT=8000
BASE_URL=http://localhost:8000

# Strict CORS Allowed Origins (comma-separated, NO wildcard * for credentials compatibility)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:8000

# File Upload Settings
MAX_FILE_SIZE_MB=10
STORAGE_TYPE=local
UPLOAD_DIR=./backend/uploads
